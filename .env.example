# Main-process runtime config
# These values are read by Electron main code and are not exposed to renderer bundles.
APP_USER_MODEL_ID=com.electron.react-starter-kit
APP_LOG_LEVEL=info
ELECTRON_RENDERER_URL=http://localhost:5173

# Microsoft Entra / Microsoft 365 auth
# Public desktop client config. Do not add a client secret for Electron.
MICROSOFT_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_AUTH_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
MICROSOFT_AUTH_REDIRECT_URI=http://localhost:38987/auth/callback
MICROSOFT_AUTH_SCOPES=openid profile email offline_access User.Read

# Renderer-visible public values
# Every VITE_* value is bundled into renderer code. Do not put secrets here.
VITE_APP_NAME="Electron React Starter Kit"
VITE_SUPPORT_URL="https://github.com/AchuAshwath/electron-react-starter-kit/issues"